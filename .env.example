# Copy this file to .env. The CLI loads a working directory .env at startup, so you do not
# need to source it. A value already exported in the shell wins over the file. Every setting
# line is an optional override. Defaults are shown where they exist. Values without defaults
# use `...` as the placeholder. Uncomment only what you actually change.
# API keys, API bases, and role seats are read only from the environment. The command line
# accepts --provider, --model, --wire-api, --retries, and --timeout for the base seat.
# The default provider order is OpenAI first, then Anthropic. With OPENAI_API_KEY or
# CYBERJURY_API_KEY set, the default is OpenAI. Without an OpenAI key, the default is
# Anthropic. Every review path uses provider APIs and requires a reachable key.

# Provider keys are read by each SDK. Set the key for your provider to call its API.
# ANTHROPIC_API_KEY is used with --provider anthropic.
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY is used with --provider openai, and makes OpenAI the default.
# OPENAI_API_KEY=...

# The primary model backend defaults to OpenAI `gpt-5.6` when an OpenAI key is reachable,
# otherwise Anthropic `claude-opus-5`.
# Valid providers are openai and anthropic.
# CYBERJURY_PROVIDER=openai
# CYBERJURY_MODEL=gpt-5.6
# CYBERJURY_API_KEY overrides the SDK key above.
# CYBERJURY_API_KEY=...
# CYBERJURY_API_BASE sets a gateway or proxy endpoint for the selected provider.
# CYBERJURY_API_BASE=...
# CYBERJURY_WIRE_API selects the OpenAI wire API. Responses is the default. Set chat only
# for a compatible endpoint that serves Chat Completions and not Responses.
# CYBERJURY_WIRE_API=responses

# The finder seat finds and answers whether two findings need one code change. A single
# model run sets none of these. Provider inherits from the base when unset. Model, API key,
# base, and wire API inherit only when the finder uses the same provider as the base; a finder
# that switches provider uses that provider's default model unless a finder model is set.
# CYBERJURY_FINDER_PROVIDER=...
# CYBERJURY_FINDER_MODEL=...
# CYBERJURY_FINDER_API_KEY=...
# CYBERJURY_FINDER_API_BASE=...
# CYBERJURY_FINDER_WIRE_API=...

# Review concurrency is intentionally per command, not env-backed: pass --concurrency on the
# command that should use it.

# Request behavior uses these optional overrides with defaults shown.
# CYBERJURY_RETRIES is the retry count after a failed model call.
# CYBERJURY_RETRIES=2
# CYBERJURY_TIMEOUT is the per call deadline in seconds and the retry hard cap.
# CYBERJURY_TIMEOUT=240

# CYBERJURY_HOME is the root for review workspace state when --workspace is not passed.
# CYBERJURY_HOME=~/.cyberjury
