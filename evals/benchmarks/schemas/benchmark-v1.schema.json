{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eth4nr00t/cyberjury/main/evals/benchmarks/schemas/benchmark-v1.schema.json",
  "title": "Benchmark Manifest Schema",
  "description": "The version 1 schema for benchmark manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "profile", "source", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"$ref": "#/$defs/slug"},
    "profile": {"$ref": "#/$defs/nonEmptyString"},
    "source": {"$ref": "#/$defs/source"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "nonEmptyString": {"type": "string", "minLength": 1},
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://", "format": "uri", "minLength": 1},
        "repository_path": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/gitCommit"}
      },
      "oneOf": [
        {"required": ["url"], "not": {"required": ["repository_path"]}},
        {"required": ["repository_path"], "not": {"required": ["url"]}}
      ]
    },
    "gitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "path"],
      "properties": {
        "kind": {"const": "git"},
        "identity": {"$ref": "#/$defs/gitIdentity"},
        "path": {"$ref": "#/$defs/path"}
      }
    },
    "source": {
      "$ref": "#/$defs/gitSource"
    },
    "repositoryRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {
        "commit": {"$ref": "#/$defs/gitCommit"}
      }
    },
    "diffRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_commit", "commit"],
      "properties": {
        "base_commit": {"$ref": "#/$defs/gitCommit"},
        "commit": {"$ref": "#/$defs/gitCommit"}
      }
    },
    "repositoryTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^repository-[0-9a-f]{7}$"},
        "kind": {"const": "repository"},
        "revision": {"$ref": "#/$defs/repositoryRevision"}
      }
    },
    "diffTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "revision", "expectation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^diff-[0-9a-f]{7}-[0-9]+$"
        },
        "kind": {"const": "diff"},
        "revision": {"$ref": "#/$defs/diffRevision"},
        "expectation": {"enum": ["findings", "clean"]}
      }
    },
    "task": {
      "oneOf": [
        {"$ref": "#/$defs/repositoryTask"},
        {"$ref": "#/$defs/diffTask"}
      ]
    }
  }
}
