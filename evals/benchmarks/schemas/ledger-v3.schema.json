{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eth4nr00t/cyberjury/main/evals/benchmarks/schemas/ledger-v3.schema.json",
  "title": "Source Assessment Ledger Schema",
  "description": "The version 3 schema for one source assessment of every report in one recorded review attempt, bound to its adjudication round, rubric, and answer key checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case", "attempt", "source_commit", "attempt_sha256", "round_id", "rubric_sha256", "checks_sha256", "records"],
  "properties": {
    "schema": {"const": "cyberjury.eval-ledger/v3"},
    "case": {"type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9-]+$"},
    "attempt": {"type": "integer", "minimum": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "attempt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "round_id": {"type": "string", "pattern": "^round-[0-9a-f]{16}$"},
    "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "verdict", "canonical_id", "check_ids", "reason", "proof_gap", "evidence"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^candidate-[0-9a-f]{20}$"},
        "verdict": {"enum": ["supported", "not_actionable", "duplicate", "needs_review"]},
        "canonical_id": {"type": ["string", "null"]},
        "check_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"$ref": "#/$defs/text"},
        "proof_gap": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      },
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "duplicate"}}},
          "then": {"properties": {"canonical_id": {"type": "string", "pattern": "^candidate-[0-9a-f]{20}$"}}},
          "else": {"properties": {"canonical_id": {"type": "null"}}}
        },
        {
          "if": {"properties": {"verdict": {"const": "needs_review"}}},
          "then": {"properties": {"proof_gap": {"$ref": "#/$defs/text"}}}
        },
        {
          "if": {"not": {"properties": {"verdict": {"enum": ["supported", "duplicate"]}}}},
          "then": {"properties": {"check_ids": {"maxItems": 0}}}
        }
      ]
    }
  }
}
