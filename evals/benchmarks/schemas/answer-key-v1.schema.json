{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eth4nr00t/cyberjury/main/evals/benchmarks/schemas/answer-key-v1.schema.json",
  "title": "Benchmark Answer Key Schema",
  "description": "The version 1 schema for benchmark answer keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"$ref": "#/$defs/slug"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {"$ref": "#/$defs/nonEmptyString"},
        "line": {"type": "integer", "minimum": 1},
        "symbol": {"$ref": "#/$defs/nonEmptyString"}
      },
      "oneOf": [
        {"required": ["line"], "not": {"required": ["symbol"]}},
        {"required": ["symbol"], "not": {"required": ["line"]}}
      ]
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/location"}
    },
    "changeAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "side"],
      "properties": {
        "file": {"$ref": "#/$defs/nonEmptyString"},
        "line": {"type": "integer", "minimum": 1},
        "side": {"enum": ["old", "new"]}
      }
    },
    "changeAnchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/changeAnchor"}
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applies_to", "locations"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "applies_to": {"$ref": "#/$defs/stringList"},
        "locations": {"$ref": "#/$defs/locations"},
        "changes": {"$ref": "#/$defs/changeAnchors"}
      }
    }
  }
}
