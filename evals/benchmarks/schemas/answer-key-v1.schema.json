{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eth4nr00t/cyberjury/main/evals/benchmarks/schemas/answer-key-v1.schema.json",
  "title": "Benchmark Answer Key Schema",
  "description": "The version 1 schema for benchmark answer keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"$ref": "#/$defs/slug"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "groupedLocations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {"$ref": "#/$defs/stringList"},
        "endpoints": {"$ref": "#/$defs/stringList"},
        "symbols": {"$ref": "#/$defs/stringList"}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {"$ref": "#/$defs/nonEmptyString"},
        "line": {"type": "integer", "minimum": 1},
        "symbol": {"$ref": "#/$defs/nonEmptyString"}
      },
      "oneOf": [
        {"required": ["line"], "not": {"required": ["symbol"]}},
        {"required": ["symbol"], "not": {"required": ["line"]}}
      ]
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/location"}
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vulnerabilities", "guides"],
      "properties": {
        "vulnerabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "guides": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "changeAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "side"],
      "properties": {
        "file": {"$ref": "#/$defs/nonEmptyString"},
        "line": {"type": "integer", "minimum": 1},
        "side": {"enum": ["old", "new"]}
      }
    },
    "changeAnchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/changeAnchor"}
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applies_to", "expectation", "knowledge", "locations"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "applies_to": {"$ref": "#/$defs/stringList"},
        "expectation": {"enum": ["findings", "clean"]},
        "knowledge": {"$ref": "#/$defs/knowledge"},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "locations": {
          "oneOf": [
            {"$ref": "#/$defs/locations"},
            {"$ref": "#/$defs/groupedLocations"}
          ]
        },
        "changes": {"$ref": "#/$defs/changeAnchors"},
        "change_anchors": {"$ref": "#/$defs/changeAnchors"}
      },
      "allOf": [
        {
          "if": {"properties": {"expectation": {"const": "findings"}}},
          "then": {"required": ["severity"]}
        },
        {
          "if": {"properties": {"expectation": {"const": "clean"}}},
          "then": {"not": {"required": ["severity"]}}
        },
        {
          "not": {"required": ["changes", "change_anchors"]}
        }
      ]
    }
  }
}
